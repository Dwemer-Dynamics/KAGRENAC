# Kagrenac Elden Ring native client: me3 v0.13.0 profile template (example). Copy outside the
# repository into the runtime folder (next to `natives/kagrenac_elden_ring.dll` and
# `config.json`) and rename to `kagrenac_elden_ring.me3`.
# Schema: me3 v0.13.0 (commit 989b522214e39c83d701f4182c4f0a86ad79a30a), schemas/mod-profile.json.
# The control package is loaded unchanged; set `path` to your built package folder
# (ports/elden-ring/control/build-package.ps1), relative to this file or absolute.
# Isolated save: back up the save folder before the first launch.
# Online stays blocked (no start_online) and anti-tamper is left alone (no disable_arxan).
# optional = false: a missing or failing DLL stops the launch, so a game without the client
# never passes for one with it loaded.
# No finalizer: me3 has no finalizer call site at the cited pin, and the DLL pins itself.
profileVersion = "v1"
savefile = "KagrenacCompanion.sl2"

[[supports]]
game = "eldenring"

[[package]]
id = "kagrenac-control"
path = "package"

[[natives]]
path = 'natives/kagrenac_elden_ring.dll'
optional = false
initializer = { function = "kagrenac_init" }
