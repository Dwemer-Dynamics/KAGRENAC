# me3 mod profile template for the KAGRENAC diagnostic probe (offline, isolated save).
# Copy outside the repository next to a `natives/` folder holding the built DLL.
# Schema: me3 v0.13.0 (commit 989b522214e39c83d701f4182c4f0a86ad79a30a), schemas/mod-profile.json.
# Back up the save folder first: me3 creates KagrenacProbe.sl2 as a copy of an existing save.
# Do not add start_online or disable_arxan.
# optional = false: a missing DLL or export fails the me3 loader; whether the game keeps
# running after that is unverified, so do not assume it survives the failure.
# kagrenac_probe_init always returns false,
# so "native failed to initialize" in the me3 log is the expected result.
profileVersion = "v1"
savefile = "KagrenacProbe.sl2"

[[supports]]
game = "eldenring"

[[natives]]
path = 'natives/kagrenac_er_probe.dll'
optional = false
initializer = { function = "kagrenac_probe_init" }
