// KAGRENAC companion control events (original), appended to the user's decompiled
// common.emevd JS by build-package.ps1 and compiled with DarkScript3 3.6.3 (/cmd -compile).
// ELDEN RING EMEDF instructions only; names and argument counts are checked against
// er-common.emedf.json before the compiler runs.
// Literals: comparison 0 = equal; backread ON = loaded; death state 0 = alive, 1 = dead;
// flag type 0 = event flag; radius state 1 = inside. @F+n@ is flag @BRIDGE_FLAG_BASE@ + n, all in
// the window build-package.ps1 audits (erpack flag-audit) against every event script, param
// and talk script of the user's game before building.
// RequestCharacterAICommand(chr, -1, 0) clears the request, as the game's own common events do.
//
// The companion is friendly from the moment it loads: its MSB part already uses the control
// think row @CONTROL_AI@ and a private NpcParam row @CONTROL_NPC@ (team @CONTROL_TEAM@), and
// with no request the control logic waits, so it holds. These events never set a team or an
// AI id (the EMEDF Team Type enum lists neither 47 nor 48), and only the control event
// addresses a character with AI calls, always the companion.
//
// Bridge window, flag @F+0@ + n (n: bits), in bytes of eight flags:
//   0-15  beacon and layout version 1 (constant, set by the init event)
//   16-19 heartbeat, 20-23 load epoch (each a 4-bit Johnson counter: one bit changes per step)
//   24-31 sensors: companion loaded, alive; hostile loaded, alive; player within 4 m and
//         15 m of the companion; hostile within @HOSTILE_NEAR@ m of the player; player in @MAP_NAME@
//   32-33 current order (00 hold, 01 follow, 10 hold, 11 attack), 34 set by a Talk press,
//   35 armed, 36 order pending, 37-38 pending order, 39 busy: sensors or a command being
//   written (set before the command byte is touched, cleared only after it is all zero)
//   40-44 acknowledgement: command nonce and op echoed; 45 accepted, 46 refused
//   48-55, 64-71 constant guards around the command byte
//   56-63 command byte, the only byte the DLL ever writes, and only while it is zero and 39 is off:
//         56-58 nonce, 59-60 op (00 no-op challenge, 01 follow, 10 hold, 11 attack), 61 valid
//   72-95 always zero
// Every byte but the command byte is written by these events only.

// Every load (and every rest): no command, acknowledgement, arming or order from a save or an
// earlier load survives, and the load epoch steps so the DLL sees a new session.
// Busy (39) is set first and stays on throughout, so the DLL neither writes the command byte
// nor reads the window while it is being cleared bit by bit; it goes off only as the last write.
Event(@E_BRIDGE_INIT@, Restart, function() {
    SetEventFlag(0, @F+39@, ON);
    BatchSetEventFlags(@F+56@, @F+63@, OFF);
    BatchSetEventFlags(@F+24@, @F+38@, OFF);
    BatchSetEventFlags(@F+40@, @F+47@, OFF);
    BatchSetEventFlags(@F+72@, @F+95@, OFF);
    GotoIfEventFlag(1, ON, 0, @F+23@);
    SkipIfEventFlag(2, ON, 0, @F+20@);
    SetEventFlag(0, @F+20@, ON);
    GotoUnconditionally(2);
    SkipIfEventFlag(2, ON, 0, @F+21@);
    SetEventFlag(0, @F+21@, ON);
    GotoUnconditionally(2);
    SkipIfEventFlag(2, ON, 0, @F+22@);
    SetEventFlag(0, @F+22@, ON);
    GotoUnconditionally(2);
    SetEventFlag(0, @F+23@, ON);
    GotoUnconditionally(2);
    Label1();
    SkipIfEventFlag(2, OFF, 0, @F+20@);
    SetEventFlag(0, @F+20@, OFF);
    GotoUnconditionally(2);
    SkipIfEventFlag(2, OFF, 0, @F+21@);
    SetEventFlag(0, @F+21@, OFF);
    GotoUnconditionally(2);
    SkipIfEventFlag(2, OFF, 0, @F+22@);
    SetEventFlag(0, @F+22@, OFF);
    GotoUnconditionally(2);
    SetEventFlag(0, @F+23@, OFF);
    Label2();
    // Beacon 10100111, version 01101001, guards 11010001 and 00111010 (flag order).
    SetEventFlag(0, @F+0@, ON);
    SetEventFlag(0, @F+1@, OFF);
    SetEventFlag(0, @F+2@, ON);
    SetEventFlag(0, @F+3@, OFF);
    SetEventFlag(0, @F+4@, OFF);
    SetEventFlag(0, @F+5@, ON);
    SetEventFlag(0, @F+6@, ON);
    SetEventFlag(0, @F+7@, ON);
    SetEventFlag(0, @F+8@, OFF);
    SetEventFlag(0, @F+9@, ON);
    SetEventFlag(0, @F+10@, ON);
    SetEventFlag(0, @F+11@, OFF);
    SetEventFlag(0, @F+12@, ON);
    SetEventFlag(0, @F+13@, OFF);
    SetEventFlag(0, @F+14@, OFF);
    SetEventFlag(0, @F+15@, ON);
    SetEventFlag(0, @F+48@, ON);
    SetEventFlag(0, @F+49@, ON);
    SetEventFlag(0, @F+50@, OFF);
    SetEventFlag(0, @F+51@, ON);
    SetEventFlag(0, @F+52@, OFF);
    SetEventFlag(0, @F+53@, OFF);
    SetEventFlag(0, @F+54@, OFF);
    SetEventFlag(0, @F+55@, ON);
    SetEventFlag(0, @F+64@, OFF);
    SetEventFlag(0, @F+65@, OFF);
    SetEventFlag(0, @F+66@, ON);
    SetEventFlag(0, @F+67@, ON);
    SetEventFlag(0, @F+68@, ON);
    SetEventFlag(0, @F+69@, OFF);
    SetEventFlag(0, @F+70@, ON);
    SetEventFlag(0, @F+71@, OFF);
    SetEventFlag(0, @F+39@, OFF);
    EndUnconditionally(End);
});

// Mailbox: publishes the sensors and one heartbeat step per pass, then answers at most one
// command. It never addresses a character; an accepted order only raises the pending flag,
// which the control event alone turns into an AI command.
Event(@E_BRIDGE_MAILBOX@, Restart, function() {
    // The init event runs in the first frame of a load, so the command byte is never read
    // before the init event has cleared it.
    WaitFixedTimeSeconds(0.5);
    SetEventFlag(0, @F+39@, ON);
    IfCharacterBackreadStatus(AND_01, @COMPANION@, ON, 0, 1);
    SkipIfConditionGroupStateUncompiled(2, PASS, AND_01);
    SetEventFlag(0, @F+24@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+24@, ON);
    IfCharacterDeadalive(AND_02, @COMPANION@, 0, 0, 1);
    SkipIfConditionGroupStateUncompiled(2, PASS, AND_02);
    SetEventFlag(0, @F+25@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+25@, ON);
    IfCharacterBackreadStatus(AND_03, @HOSTILE@, ON, 0, 1);
    SkipIfConditionGroupStateUncompiled(2, PASS, AND_03);
    SetEventFlag(0, @F+26@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+26@, ON);
    IfCharacterDeadalive(AND_04, @HOSTILE@, 0, 0, 1);
    SkipIfConditionGroupStateUncompiled(2, PASS, AND_04);
    SetEventFlag(0, @F+27@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+27@, ON);
    IfEntityInoutsideRadiusOfEntity(AND_05, 1, @COMPANION@, @PLAYER@, 4, 1);
    SkipIfConditionGroupStateUncompiled(2, PASS, AND_05);
    SetEventFlag(0, @F+28@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+28@, ON);
    IfEntityInoutsideRadiusOfEntity(AND_06, 1, @COMPANION@, @PLAYER@, 15, 1);
    SkipIfConditionGroupStateUncompiled(2, PASS, AND_06);
    SetEventFlag(0, @F+29@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+29@, ON);
    IfEntityInoutsideRadiusOfEntity(AND_07, 1, @HOSTILE@, @PLAYER@, @HOSTILE_NEAR@, 1);
    SkipIfConditionGroupStateUncompiled(2, PASS, AND_07);
    SetEventFlag(0, @F+30@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+30@, ON);
    IfPlayerInoutMap(AND_08, 1, @MAP_AREA@, @MAP_BLOCK@, @MAP_REGION@, @MAP_INDEX@);
    SkipIfConditionGroupStateUncompiled(2, PASS, AND_08);
    SetEventFlag(0, @F+31@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+31@, ON);
    SetEventFlag(0, @F+39@, OFF);
    // Heartbeat: one Johnson step, after the sensors, so a new step means a finished pass.
    GotoIfEventFlag(1, ON, 0, @F+19@);
    SkipIfEventFlag(2, ON, 0, @F+16@);
    SetEventFlag(0, @F+16@, ON);
    GotoUnconditionally(2);
    SkipIfEventFlag(2, ON, 0, @F+17@);
    SetEventFlag(0, @F+17@, ON);
    GotoUnconditionally(2);
    SkipIfEventFlag(2, ON, 0, @F+18@);
    SetEventFlag(0, @F+18@, ON);
    GotoUnconditionally(2);
    SetEventFlag(0, @F+19@, ON);
    GotoUnconditionally(2);
    Label1();
    SkipIfEventFlag(2, OFF, 0, @F+16@);
    SetEventFlag(0, @F+16@, OFF);
    GotoUnconditionally(2);
    SkipIfEventFlag(2, OFF, 0, @F+17@);
    SetEventFlag(0, @F+17@, OFF);
    GotoUnconditionally(2);
    SkipIfEventFlag(2, OFF, 0, @F+18@);
    SetEventFlag(0, @F+18@, OFF);
    GotoUnconditionally(2);
    SetEventFlag(0, @F+19@, OFF);
    Label2();
    // A command, or the next pass.
    IfEventFlag(OR_01, ON, 0, @F+61@);
    IfElapsedSeconds(OR_01, 1);
    IfConditionGroup(MAIN, PASS, OR_01);
    EndIfEventFlag(Restart, OFF, 0, @F+61@);
    // Busy from here until the command byte is wholly clear: the batch clear below may write
    // bit by bit, and the DLL neither reads the answer nor writes while busy is on.
    SetEventFlag(0, @F+39@, ON);
    // The wait compiled the groups; clear that (EMEDF 2000[3]) so the order checks below use
    // only AND_09 and AND_10, registered fresh after the wait.
    ClearCompiledConditionGroupState(0);
    // Echo nonce and op (one write per bit), then decide. The DLL reads the acknowledgement
    // only once the command byte is zero and busy is off again, the last two writes below.
    SkipIfEventFlag(2, ON, 0, @F+56@);
    SetEventFlag(0, @F+40@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+40@, ON);
    SkipIfEventFlag(2, ON, 0, @F+57@);
    SetEventFlag(0, @F+41@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+41@, ON);
    SkipIfEventFlag(2, ON, 0, @F+58@);
    SetEventFlag(0, @F+42@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+42@, ON);
    SkipIfEventFlag(2, ON, 0, @F+59@);
    SetEventFlag(0, @F+43@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+43@, ON);
    SkipIfEventFlag(2, ON, 0, @F+60@);
    SetEventFlag(0, @F+44@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+44@, ON);
    SetEventFlag(0, @F+45@, OFF);
    SetEventFlag(0, @F+46@, OFF);
    // Reserved command bits set: refused.
    GotoIfEventFlag(3, ON, 0, @F+62@);
    GotoIfEventFlag(3, ON, 0, @F+63@);
    // No-op challenge: arms the mailbox for this load.
    GotoIfEventFlag(4, ON, 0, @F+59@);
    GotoIfEventFlag(4, ON, 0, @F+60@);
    SetEventFlag(0, @F+35@, ON);
    GotoUnconditionally(5);
    Label4();
    // An order: armed this load, no order still waiting for the control event, companion
    // loaded and alive now; attack also needs the hostile loaded and alive now.
    GotoIfEventFlag(3, OFF, 0, @F+35@);
    GotoIfEventFlag(3, ON, 0, @F+36@);
    IfCharacterBackreadStatus(AND_09, @COMPANION@, ON, 0, 1);
    IfCharacterDeadalive(AND_09, @COMPANION@, 0, 0, 1);
    GotoIfConditionGroupStateUncompiled(3, FAIL, AND_09);
    GotoIfEventFlag(6, OFF, 0, @F+59@);
    GotoIfEventFlag(6, OFF, 0, @F+60@);
    IfCharacterBackreadStatus(AND_10, @HOSTILE@, ON, 0, 1);
    IfCharacterDeadalive(AND_10, @HOSTILE@, 0, 0, 1);
    GotoIfConditionGroupStateUncompiled(3, FAIL, AND_10);
    Label6();
    SkipIfEventFlag(2, ON, 0, @F+59@);
    SetEventFlag(0, @F+37@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+37@, ON);
    SkipIfEventFlag(2, ON, 0, @F+60@);
    SetEventFlag(0, @F+38@, OFF);
    SkipUnconditionally(1);
    SetEventFlag(0, @F+38@, ON);
    SetEventFlag(0, @F+36@, ON);
    GotoUnconditionally(5);
    Label3();
    SetEventFlag(0, @F+46@, ON);
    GotoUnconditionally(7);
    Label5();
    SetEventFlag(0, @F+45@, ON);
    Label7();
    BatchSetEventFlags(@F+56@, @F+63@, OFF);
    SetEventFlag(0, @F+39@, OFF);
    // Next pass: sensors, heartbeat and the next command.
    EndUnconditionally(Restart);
});

// Control: the one owner of the companion's order. Where the event is waiting is the state:
// hold -> follow -> hold -> attack -> release, one action-button press per step, plus any
// order the mailbox accepted (pending flag), which restarts the event and is applied at the
// top. A Talk press always wins: it steps the cycle and drops an order still pending.
// Release, cancellation, the companion unloading or dying, and every load restart the event,
// which waits until the companion is loaded and alive and puts it back to a friendly hold
// (request cleared, AI target cleared). Each wait reuses condition groups, so the compiled
// state of the previous wait is cleared first (EMEDF 2000[3]).
// Groups: OR_01 companion lost; AND_01 press on the loaded, alive companion; OR_03 attack
// over (hostile lost or lease elapsed); OR_02 the wait itself; AND_02 companion present at the
// top; AND_04 hostile guard.
Event(@E_CONTROL@, Restart, function() {
    // An order pending for a companion that is not loaded and alive now is dropped.
    IfCharacterBackreadStatus(AND_02, @COMPANION@, ON, 0, 1);
    IfCharacterDeadalive(AND_02, @COMPANION@, 0, 0, 1);
    SkipIfConditionGroupStateUncompiled(1, PASS, AND_02);
    SetEventFlag(0, @F+36@, OFF);
    // Safe hold: only once the companion is loaded and alive.
    IfCharacterBackreadStatus(AND_01, @COMPANION@, ON, 0, 1);
    IfCharacterDeadalive(AND_01, @COMPANION@, 0, 0, 1);
    IfConditionGroup(MAIN, PASS, AND_01);
    RequestCharacterAICommand(@COMPANION@, -1, 0);
    ClearCharactersAITarget(@COMPANION@);
    RequestCharacterAIReplan(@COMPANION@);
    SetEventFlag(0, @F+32@, OFF);
    SetEventFlag(0, @F+33@, OFF);
    // A pending order: hold (10) is this hold, follow (01) and attack (11) jump to their step.
    GotoIfEventFlag(5, OFF, 0, @F+36@);
    SetEventFlag(0, @F+36@, OFF);
    SetEventFlag(0, @F+34@, OFF);
    GotoIfEventFlag(5, OFF, 0, @F+37@);
    GotoIfEventFlag(1, OFF, 0, @F+38@);
    GotoUnconditionally(3);
    Label5();
    // One press, one step: no wait below sees the same press.
    WaitFixedTimeSeconds(1);
    ClearCompiledConditionGroupState(0);
    IfCharacterBackreadStatus(OR_01, @COMPANION@, OFF, 0, 1);
    IfCharacterDeadalive(OR_01, @COMPANION@, 1, 0, 1);
    IfCharacterBackreadStatus(AND_01, @COMPANION@, ON, 0, 1);
    IfCharacterDeadalive(AND_01, @COMPANION@, 0, 0, 1);
    IfActionButtonInArea(AND_01, @BUTTON_PARAM@, @COMPANION@);
    IfConditionGroup(OR_02, PASS, OR_01);
    IfConditionGroup(OR_02, PASS, AND_01);
    IfEventFlag(OR_02, ON, 0, @F+36@);
    IfConditionGroup(MAIN, PASS, OR_02);
    GotoIfConditionGroupStateCompiled(0, PASS, OR_01);
    SkipIfConditionGroupStateCompiled(1, PASS, AND_01);
    EndUnconditionally(Restart);
    SetEventFlag(0, @F+34@, ON);
    SetEventFlag(0, @F+36@, OFF);
    Label1();
    // Follow the player (the logic targets the local player itself).
    SetEventFlag(0, @F+32@, ON);
    SetEventFlag(0, @F+33@, OFF);
    ClearCharactersAITarget(@COMPANION@);
    RequestCharacterAICommand(@COMPANION@, @CMD_FOLLOW@, 0);
    RequestCharacterAIReplan(@COMPANION@);
    WaitFixedTimeSeconds(1);
    ClearCompiledConditionGroupState(0);
    IfCharacterBackreadStatus(OR_01, @COMPANION@, OFF, 0, 1);
    IfCharacterDeadalive(OR_01, @COMPANION@, 1, 0, 1);
    IfCharacterBackreadStatus(AND_01, @COMPANION@, ON, 0, 1);
    IfCharacterDeadalive(AND_01, @COMPANION@, 0, 0, 1);
    IfActionButtonInArea(AND_01, @BUTTON_PARAM@, @COMPANION@);
    IfConditionGroup(OR_02, PASS, OR_01);
    IfConditionGroup(OR_02, PASS, AND_01);
    IfEventFlag(OR_02, ON, 0, @F+36@);
    IfConditionGroup(MAIN, PASS, OR_02);
    GotoIfConditionGroupStateCompiled(0, PASS, OR_01);
    SkipIfConditionGroupStateCompiled(1, PASS, AND_01);
    EndUnconditionally(Restart);
    SetEventFlag(0, @F+34@, ON);
    SetEventFlag(0, @F+36@, OFF);
    // Hold in place (by Talk only; a bridge hold is the hold at the top).
    SetEventFlag(0, @F+32@, OFF);
    SetEventFlag(0, @F+33@, ON);
    RequestCharacterAICommand(@COMPANION@, @CMD_HOLD@, 0);
    RequestCharacterAIReplan(@COMPANION@);
    WaitFixedTimeSeconds(1);
    ClearCompiledConditionGroupState(0);
    IfCharacterBackreadStatus(OR_01, @COMPANION@, OFF, 0, 1);
    IfCharacterDeadalive(OR_01, @COMPANION@, 1, 0, 1);
    IfCharacterBackreadStatus(AND_01, @COMPANION@, ON, 0, 1);
    IfCharacterDeadalive(AND_01, @COMPANION@, 0, 0, 1);
    IfActionButtonInArea(AND_01, @BUTTON_PARAM@, @COMPANION@);
    IfConditionGroup(OR_02, PASS, OR_01);
    IfConditionGroup(OR_02, PASS, AND_01);
    IfEventFlag(OR_02, ON, 0, @F+36@);
    IfConditionGroup(MAIN, PASS, OR_02);
    GotoIfConditionGroupStateCompiled(0, PASS, OR_01);
    SkipIfConditionGroupStateCompiled(1, PASS, AND_01);
    EndUnconditionally(Restart);
    SetEventFlag(0, @F+34@, ON);
    SetEventFlag(0, @F+36@, OFF);
    Label3();
    // Attack only the configured hostile, only while it is loaded and alive now; otherwise
    // this step releases (back to a friendly hold) instead.
    IfCharacterBackreadStatus(AND_04, @HOSTILE@, ON, 0, 1);
    IfCharacterDeadalive(AND_04, @HOSTILE@, 0, 0, 1);
    GotoIfConditionGroupStateUncompiled(0, FAIL, AND_04);
    SetEventFlag(0, @F+32@, ON);
    SetEventFlag(0, @F+33@, ON);
    SetCharacterEventTarget(@COMPANION@, @HOSTILE@);
    RequestCharacterAICommand(@COMPANION@, @CMD_ATTACK@, 0);
    RequestCharacterAIReplan(@COMPANION@);
    WaitFixedTimeSeconds(1);
    // The lease is this wait's own timeout: a press, a pending order, the hostile unloading
    // or dying, or @ATTACK_LEASE@ s all release.
    ClearCompiledConditionGroupState(0);
    IfCharacterBackreadStatus(OR_01, @COMPANION@, OFF, 0, 1);
    IfCharacterDeadalive(OR_01, @COMPANION@, 1, 0, 1);
    IfCharacterBackreadStatus(OR_03, @HOSTILE@, OFF, 0, 1);
    IfCharacterDeadalive(OR_03, @HOSTILE@, 1, 0, 1);
    IfElapsedSeconds(OR_03, @ATTACK_LEASE@);
    IfCharacterBackreadStatus(AND_01, @COMPANION@, ON, 0, 1);
    IfCharacterDeadalive(AND_01, @COMPANION@, 0, 0, 1);
    IfActionButtonInArea(AND_01, @BUTTON_PARAM@, @COMPANION@);
    IfConditionGroup(OR_02, PASS, OR_01);
    IfConditionGroup(OR_02, PASS, OR_03);
    IfConditionGroup(OR_02, PASS, AND_01);
    IfEventFlag(OR_02, ON, 0, @F+36@);
    IfConditionGroup(MAIN, PASS, OR_02);
    SkipIfConditionGroupStateCompiled(2, FAIL, AND_01);
    SetEventFlag(0, @F+34@, ON);
    SetEventFlag(0, @F+36@, OFF);
    Label0();
    // Release, cancel, companion lost or a pending order: restart, which waits for the
    // companion, holds, then applies the pending order if there is one.
    EndUnconditionally(Restart);
});
