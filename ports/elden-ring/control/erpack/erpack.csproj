<!-- Original KAGRENAC pack tool. Built outside the repository only:
     dotnet build -p:KgOut=<dir outside repo> -p:SoulsLib=<folder with the user's SoulsFormats.dll> -->
<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(KgOut)\obj\</BaseIntermediateOutputPath>
    <!-- No Directory.Build.* from above the project may redirect output into the repository. -->
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <OutputPath>$(KgOut)\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <Target Name="KgCheck" BeforeTargets="Restore;Build">
    <Error Condition="'$(KgOut)' == '' Or '$(SoulsLib)' == ''" Text="Set -p:KgOut and -p:SoulsLib (both outside the repository)." />
  </Target>
  <ItemGroup>
    <Reference Include="SoulsFormats"><HintPath>$(SoulsLib)\SoulsFormats.dll</HintPath></Reference>
    <Reference Include="ZstdNet"><HintPath>$(SoulsLib)\ZstdNet.dll</HintPath></Reference>
    <Reference Include="DrSwizzler"><HintPath>$(SoulsLib)\DrSwizzler.dll</HintPath></Reference>
    <None Include="$(SoulsLib)\libzstd.dll" Link="libzstd.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
