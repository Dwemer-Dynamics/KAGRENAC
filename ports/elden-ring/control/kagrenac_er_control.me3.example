# KAGRENAC Elden Ring companion control: me3 v0.13.0 profile template (example).
# Copy this file outside the repository, next to the `package` folder that
# build-package.ps1 wrote into its -OutDir, and rename the copy to end in `.me3`.
# Asset overrides only: no natives. Online play stays blocked (no start_online) and
# anti-tamper is left alone (no disable_arxan).
# savefile is a separate save name; me3 creates it as a copy of an existing save the
# first time, so back up the save folder before the first launch.
profileVersion = "v1"
savefile = "KagrenacControl.sl2"

[[supports]]
game = "eldenring"

[[package]]
id = "kagrenac-control"
path = "package"
