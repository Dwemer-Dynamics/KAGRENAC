-- KAGRENAC companion control: AI logic for one opted-in NPC (original code).
-- Generated by build-package.ps1 and compiled with Lua 5.0.3 (x64, same header as the
-- game's aicommon entries). Registered as logic @LOGIC_ID@ (@LOGIC_NAME@_Logic /
-- @LOGIC_NAME@_Interupt) in aicommon LUAINFO and in its own per-logic luabnd, as the game
-- ships its logics, and selected through the cloned NpcThinkParam row @CONTROL_AI@, which
-- the companion's own MSB part uses from the start.
-- Every call below has the same name and argument shape as calls in the game's own
-- bytecode: ai:GetEventRequest() reads slot 0 (as logic 10000 does),
-- GOAL_COMMON_ApproachTarget(life, target, dist, TARGET_SELF, walk, -1) (the shape of the
-- game's own approaches to TARGET_LOCALPLAYER), GOAL_COMMON_Turn(life, target, 0, 0, 0),
-- GOAL_COMMON_Wait(life, TARGET_NONE, 0, 0, 0) and
-- GOAL_COMMON_AttackTunableSpin(life, anim, target, successDist, turnTime, frontAngle, 0, 0)
-- (aicommon AddTopGoal shape). @ATTACK_ANIM@ is an attack the NPC's own battle goal
-- requests. Follow uses TARGET_LOCALPLAYER (21 in ai_define, used by the game's own logic
-- files); attack uses TARGET_EVENT (20 in ai_define), the one fixed hostile the event script
-- sets; its approach repeats the target as the fourth argument, as some game battle goals
-- do with TARGET_ENE_0. COMMON_EasySetup_Initial is not called: it can queue its own top
-- goals (22 AddTopGoal sites, some on TARGET_ENE_0) ahead of the order. COMMON_Initialize
-- has no direct AddTopGoal site (helpers it may call were not checked). This logic
-- never falls back to the NPC's normal combat, so it cannot pick another target.

local CMD_HOLD = @CMD_HOLD@
local CMD_FOLLOW = @CMD_FOLLOW@
local CMD_ATTACK = @CMD_ATTACK@
local FOLLOW_MIN = @FOLLOW_MIN@
local FOLLOW_MAX = @FOLLOW_MAX@
local ATTACK_REACH = @ATTACK_REACH@
local ATTACK_ANIM = @ATTACK_ANIM@

-- Short top goals per call; when they end the engine calls the logic again, so a new
-- order is read within a few seconds and no goal chain can grow.
function @LOGIC_NAME@_Logic(ai)
    COMMON_Initialize(ai)
    local request = ai:GetEventRequest()
    if request == CMD_FOLLOW then
        if ai:GetDist(TARGET_LOCALPLAYER) > FOLLOW_MAX then
            ai:AddTopGoal(GOAL_COMMON_ApproachTarget, 3, TARGET_LOCALPLAYER, FOLLOW_MIN, TARGET_SELF, false, -1)
        else
            -- In range (as right after the press): face the player, meant as a visible sign
            -- that the follow order reached this logic (not seen in game); hold does not turn.
            ai:AddTopGoal(GOAL_COMMON_Turn, 2, TARGET_LOCALPLAYER, 0, 0, 0)
            ai:AddTopGoal(GOAL_COMMON_Wait, 1, TARGET_NONE, 0, 0, 0)
        end
    elseif request == CMD_ATTACK then
        if ai:GetDist(TARGET_EVENT) > ATTACK_REACH then
            ai:AddTopGoal(GOAL_COMMON_ApproachTarget, 3, TARGET_EVENT, ATTACK_REACH, TARGET_EVENT, false, -1)
        else
            ai:AddTopGoal(GOAL_COMMON_AttackTunableSpin, 5, ATTACK_ANIM, TARGET_EVENT, ATTACK_REACH, 0, 180, 0, 0)
        end
    else
        -- Hold, no order (the start), a cleared order or an unknown one: wait.
        ai:AddTopGoal(GOAL_COMMON_Wait, 1, TARGET_NONE, 0, 0, 0)
    end
end

function @LOGIC_NAME@_Interupt(ai, goal)
    return false
end
