-- KAGRENAC companion control: AI logic for one opted-in NPC (original code).
-- Generated by build-package.ps1 and compiled with Lua 5.0.3 (x64, same header as the
-- game's aicommon entries). Registered in aicommon LUAINFO as logic @LOGIC_ID@
-- (@LOGIC_NAME@_Logic / @LOGIC_NAME@_Interupt) and selected only through the cloned
-- NpcThinkParam row @CONTROL_AI@ while the event script has the NPC under control.
-- Every call below has the same name and argument shape as calls in the game's own
-- bytecode: ai:GetEventRequest() reads slot 0 (as logic 10000 does),
-- GOAL_COMMON_ApproachTarget(life, target, dist, turnTarget, walk, -1 = no guard),
-- GOAL_COMMON_Wait(life, TARGET_NONE, 0, 0, 0) and
-- GOAL_COMMON_AttackTunableSpin(life, anim, target, successDist, turnTime, frontAngle, 0, 0)
-- (aicommon AddTopGoal shape). @ATTACK_ANIM@ is an attack the NPC's own battle goal
-- requests. TARGET_EVENT (20 in ai_define) is set by the event script: the player for
-- follow, the one fixed hostile for attack. The event script clears the request with -1
-- and restores the original think row and team; this logic never falls back to the NPC's
-- normal combat, so it cannot pick another target while controlled.

local CMD_HOLD = @CMD_HOLD@
local CMD_FOLLOW = @CMD_FOLLOW@
local CMD_ATTACK = @CMD_ATTACK@
local FOLLOW_MIN = @FOLLOW_MIN@
local FOLLOW_MAX = @FOLLOW_MAX@
local ATTACK_REACH = @ATTACK_REACH@
local ATTACK_ANIM = @ATTACK_ANIM@

-- One short top goal per call; when it ends the engine calls the logic again, so a new
-- order is read within a few seconds and no goal chain can grow.
function @LOGIC_NAME@_Logic(ai)
    COMMON_Initialize(ai)
    -- Only a true result means the common setup already queued a goal; nil and false
    -- both fall through to the order.
    if COMMON_EasySetup_Initial(ai) then
        return
    end
    local request = ai:GetEventRequest()
    if request == CMD_FOLLOW and ai:GetDist(TARGET_EVENT) > FOLLOW_MAX then
        ai:AddTopGoal(GOAL_COMMON_ApproachTarget, 3, TARGET_EVENT, FOLLOW_MIN, TARGET_EVENT, false, -1)
    elseif request == CMD_ATTACK then
        if ai:GetDist(TARGET_EVENT) > ATTACK_REACH then
            ai:AddTopGoal(GOAL_COMMON_ApproachTarget, 3, TARGET_EVENT, ATTACK_REACH, TARGET_EVENT, false, -1)
        else
            ai:AddTopGoal(GOAL_COMMON_AttackTunableSpin, 5, ATTACK_ANIM, TARGET_EVENT, ATTACK_REACH, 0, 180, 0, 0)
        end
    else
        -- Hold, follow within range, no order, a cleared order or an unknown one: wait.
        ai:AddTopGoal(GOAL_COMMON_Wait, 1, TARGET_NONE, 0, 0, 0)
    end
end

function @LOGIC_NAME@_Interupt(ai, goal)
    return false
end
